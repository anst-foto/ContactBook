{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "internalLogLevel": "Off",
    "throwConfigExceptions": true,
    "extensions": [
      {
        "assembly": "NLog.Targets.AtomicFile"
      }
    ],
    "targets": {
      "console": {
        "type": "Console",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}"
      },
      "file": {
        "type": "AtomFile",
        "fileName": "${basedir}/logs/contactbook-${shortdate}.log",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}",
        "archiveEvery": "Day",
        "archiveNumbering": "Date",
        "maxArchiveFiles": 14,
        "encoding": "utf-8"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "console"
      },
      {
        "logger": "*",
        "minLevel": "Information",
        "writeTo": "file"
      }
    ]
  },
  "RunMigrations": true,
  "AllowedHosts": "*"
}