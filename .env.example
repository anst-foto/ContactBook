# PostgreSQL
POSTGRES_DB=contactbook_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=1234

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@mail.mail
PGADMIN_DEFAULT_PASSWORD=1234
PGADMIN_CONFIG_SERVER_MODE=False

# Порты (только localhost по умолчанию)
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# Ресурсы
POSTGRES_CPUS=1
POSTGRES_MEMORY=4G
PGADMIN_CPUS=0.5
PGADMIN_MEMORY=1G