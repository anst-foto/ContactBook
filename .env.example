# ==============================================================
# ContactBook — переменные окружения
# Скопируйте в .env и замените пароли перед запуском:
#     cp .env.example .env
# ==============================================================

# Имя решения — влияет на имена контейнеров и образов
SOLUTION_NAME=contactbook

# --------------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------------
POSTGRES_DB=contactbook_db
POSTGRES_USER=contactbook_app
POSTGRES_PASSWORD=change-me

# --------------------------------------------------------------
# pgAdmin
# --------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_CONFIG_SERVER_MODE=False

# --------------------------------------------------------------
# Порты (только localhost по умолчанию)
# --------------------------------------------------------------
API_PORT=8080
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# --------------------------------------------------------------
# ASP.NET Core
# --------------------------------------------------------------
# Development — Swagger UI доступен по /swagger, подробные логи.
# Production  — Swagger выключен, минимум логов (рекомендуется для внешнего контура).
ASPNETCORE_ENVIRONMENT=Development

# Автоматически применять миграции EF Core при старте.
# Выключите (false), если запускаете несколько реплик api.
RUN_MIGRATIONS=true

# --------------------------------------------------------------
# Ресурсы
# --------------------------------------------------------------
POSTGRES_CPUS=1
POSTGRES_MEMORY=4G
PGADMIN_CPUS=0.5
PGADMIN_MEMORY=1G
API_CPUS=1
API_MEMORY=1G

# --------------------------------------------------------------
# Логи
# --------------------------------------------------------------
# Уровень NLog (можно переопределить, если используете ${var:...} в appsettings.json)
NLOG_LOG_LEVEL=Information