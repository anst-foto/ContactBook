# PostgreSQL
POSTGRES_DB=contactbook_db
POSTGRES_USER=contactbook_app
POSTGRES_PASSWORD=change-me

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_CONFIG_SERVER_MODE=False

# Порты (только localhost по умолчанию)
API_PORT=8080
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# Ресурсы
POSTGRES_CPUS=1
POSTGRES_MEMORY=4G
PGADMIN_CPUS=0.5
PGADMIN_MEMORY=1G
